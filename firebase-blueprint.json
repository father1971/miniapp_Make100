{
  "entities": {
    "TelegramUserStats": {
      "title": "Telegram User Profile and Game Stats",
      "description": "Consolidated record of a Telegram player, including stats, settings, and profile info",
      "type": "object",
      "properties": {
        "tgUserId": { "type": "number", "description": "Telegram user ID" },
        "firstName": { "type": "string", "description": "Player's first name" },
        "lastName": { "type": "string", "description": "Player's last name" },
        "photoUrl": { "type": "string", "description": "Player's avatar photo URL" },
        "username": { "type": "string", "description": "Telegram username" },
        "solvedCount": { "type": "number", "description": "Number of tickets solved" },
        "unsolvedCount": { "type": "number", "description": "Number of tickets unsolved/skipped" },
        "totalSolveTime": { "type": "number", "description": "Total time spent solving in seconds" },
        "totalOperatorsUsed": { "type": "number", "description": "Total number of mathematical operators used" },
        "themePreference": { "type": "string", "description": "Theme: light, dark, or system" },
        "language": { "type": "string", "description": "Selected language code" },
        "gameMode": { "type": "string", "description": "Selected game mode: ticket, car, etc." },
        "soundEnabled": { "type": "boolean", "description": "Whether sound is enabled" },
        "vibrationEnabled": { "type": "boolean", "description": "Whether vibration is enabled" },
        "hasSeenOnboarding": { "type": "boolean", "description": "Whether onboarding demo has been seen" }
      },
      "required": ["tgUserId", "firstName"]
    }
  },
  "firestore": {
    "/tg_users/{userId}": {
      "schema": "TelegramUserStats",
      "description": "Consolidated Telegram user record containing stats, settings, and ratings."
    }
  }
}
